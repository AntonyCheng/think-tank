# syntax=docker/dockerfile:1.7

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ARG PIP_EXTRA_INDEX_URL=

WORKDIR /app/mcp-server

COPY mcp-server/requirements.txt ./requirements.txt
RUN --mount=type=cache,id=thinktank-mcp-pip,target=/root/.cache/pip,sharing=locked \
    if [ -n "${PIP_EXTRA_INDEX_URL}" ]; then \
      python -m pip install \
        --index-url "${PIP_INDEX_URL}" \
        --extra-index-url "${PIP_EXTRA_INDEX_URL}" \
        -r requirements.txt; \
    else \
      python -m pip install \
        --index-url "${PIP_INDEX_URL}" \
        -r requirements.txt; \
    fi

COPY mcp-server/*.py ./
RUN mkdir -p /app/mcp-server/artifacts

EXPOSE 7010

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD python -c "import socket; connection=socket.create_connection(('127.0.0.1', 7010), 3); connection.close()"

CMD ["python", "server.py"]
