FROM node:22-bookworm-slim AS build

ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/orchestrator/package.json apps/orchestrator/package.json
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,id=thinktank-npm,target=/root/.npm,sharing=locked \
    npm ci --prefer-offline --no-audit --no-fund

COPY apps/orchestrator/tsconfig.json apps/orchestrator/tsconfig.json
COPY apps/orchestrator/src apps/orchestrator/src
RUN npm run build --workspace @think-tank/orchestrator

FROM node:22-bookworm-slim AS runtime

ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/orchestrator/package.json apps/orchestrator/package.json
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,id=thinktank-npm,target=/root/.npm,sharing=locked \
    npm ci --omit=dev --prefer-offline --no-audit --no-fund

COPY --from=build /app/apps/orchestrator/dist/src apps/orchestrator/dist/src
RUN mkdir -p /app/empty-web /app/.think-tank /app/config

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "apps/orchestrator/dist/src/api-server.js"]
