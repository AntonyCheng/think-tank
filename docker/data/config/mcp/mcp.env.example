# MCP 远程访问配置。部署前复制为 mcp.env 并替换所有占位值。

# 远程 Agent 连接 MCP 时使用的鉴权密钥。
MCP_API_KEY=change-me-before-remote-use

# Agent 可访问的 MCP 外部地址，用于生成 Word、Markdown 和 PDF 下载链接。
# 只填写协议、IP（或域名）和端口，不要添加 /mcp。
MCP_PUBLIC_BASE_URL=http://10.9.0.106:7010

# 必须与 api.env 中的 ORCHESTRATOR_SERVICE_API_KEY 完全一致。
THINK_TANK_SERVICE_API_KEY=change-me-before-use

# 报告分页和临时下载文件有效期
REPORT_PAGE_CHARACTERS=6000
ARTIFACT_TTL_MINUTES=15

