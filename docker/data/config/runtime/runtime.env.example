# 模型、搜索和研究运行参数。部署前复制为 runtime.env 并填写真实值。
# API 与 Researcher 共用此文件；在设置页面更新的模型密钥也会写回此文件。

# OpenAI 兼容模型服务
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=change-me
AO_PLANNER_MODEL=change-me
AO_PLANNER_MAX_TOKENS=8192
AO_VERIFIER_MODEL=change-me
GPTR_FAST_LLM=change-me
GPTR_SMART_LLM=change-me

# 可选的备用 OpenAI 兼容模型服务。仅在主服务发生网络、超时、限流或 5xx 错误时切换。
# 保持 false 或留空即可禁用；向量模型不使用这组配置。
FALLBACK_MODEL_ENABLED=false
FALLBACK_OPENAI_BASE_URL=
FALLBACK_OPENAI_API_KEY=
FALLBACK_AO_PLANNER_MODEL=
FALLBACK_AO_VERIFIER_MODEL=
FALLBACK_GPTR_FAST_LLM=
FALLBACK_GPTR_SMART_LLM=

# OpenAI 兼容向量模型服务。独立密钥不要与大模型密钥混用。
GPTR_EMBEDDING_BASE_URL=
GPTR_EMBEDDING_API_KEY=change-me
GPTR_EMBEDDING=change-me

# 网页检索。
# - 境内服务器：DuckDuckGo / Google 均不可直连。用本地 SearXNG（settings.yml 已
#   改为境内可用的 360search/quark 引擎），可选配 Tavily（api.tavily.com，境外，
#   需 TAVILY_API_KEY，境内可达性视网络而定）。
# - 可出海的环境：可加回 duckduckgo。
GPTR_ENABLED_RETRIEVERS=searx,tavily
RETRIEVER=searx
SEARX_URL=http://thinktank-searxng:8080
TAVILY_API_KEY=
GPTR_MAX_RETRIEVERS=3
GPTR_RETRIEVER_TIMEOUT_MS=20000
# 检索到的来源按与研究主题的向量相似度过滤，剔除搜索引擎返回的不相关页面。
# 设 0 关闭；GPTR_SOURCE_RELEVANCE_MIN_COSINE 调阈值（默认 0.18）。
GPTR_SOURCE_RELEVANCE_FILTER=1

# 并发和深度研究限制
AO_CONCURRENCY=2
GPTR_WORKER_CONCURRENCY=2
GPTR_TASK_CONCURRENCY_BUDGET=4
GPTR_DEEP_MAX_BREADTH=4
GPTR_DEEP_MAX_DEPTH=3
GPTR_DEEP_MAX_RESEARCH_CALLS=32
# 留空时由 AO 规划器按任务判断是否使用 deep 模式。设为 1（或 "2x1x1" 指定
# breadth x depth x concurrency）会强制所有纯 Web 专家步骤走 deep，便于验证或压测；
# breadth/depth 仍受上面的上限约束。
GPTR_RESEARCH_FORCE_DEEP=

# 超时与时间语义
APP_TIMEZONE=Asia/Shanghai
# 设置页面“检测主模型”的请求超时，默认 30 秒；单位为毫秒。
MODEL_PREFLIGHT_TIMEOUT_MS=30000
# AO 编排/验证走流式调用，默认 90 秒内首个 token 未到就判定“卡住”并中断。
# 若网关会先缓冲整段响应再吐（大提示词首 token 可能 >90 秒），调大此值。单位毫秒。
AO_STREAM_STALL_MS=90000
GPTR_HEALTH_TIMEOUT_MS=5000
GPTR_RESEARCH_TIMEOUT_MS=1800000
GPTR_CLEANUP_GRACE_MS=20000
TASK_EXECUTION_TIMEOUT_MS=7200000

# 网页读取和本地文档限制
# 静态抓取被拒绝、正文为空、明显过短，或页面是脚本渲染的空壳时，使用单页浏览器兜底。
# 留空也会默认启用 browser；填写 none 可在受限环境中显式关闭。
GPTR_SOURCE_FALLBACK_PROVIDERS=browser
GPTR_SOURCE_FALLBACK_TIMEOUT_MS=45000
# 浏览器兜底默认允许加载目标域名及公网 CDN 上的子资源（每个跨域主机先过 SSRF 预检），
# 以便单页应用真正渲染。设为 strict 可限制浏览器只访问目标域名本身。
GPTR_SOURCE_BROWSER_ISOLATION=
# 出口代理，仅作用于“指定 URL”来源抓取与浏览器兜底。SSRF 预检仍生效。
GPTR_SOURCE_HTTP_PROXY=
LOCAL_DOCUMENT_MAX_BYTES=26214400
LOCAL_DOCUMENT_TASK_MAX_BYTES=104857600
LOCAL_DOCUMENT_MAX_COUNT=20
LOCAL_DOCUMENT_PARSE_TIMEOUT_MS=30000
LOCAL_DOCUMENT_MAX_TEXT_CHARACTERS=200000

# 上游专家网页证据上下文治理。仅作用于上游专家写报告前的来源正文，
# 不改变最终综合专家的“只接收上游报告与来源目录”策略。
GPTR_WEB_EVIDENCE_CONTEXT_BUDGET_CHARS=250000
GPTR_WEB_EVIDENCE_SOURCE_COMPRESS_THRESHOLD_CHARS=2500
GPTR_WEB_EVIDENCE_SOURCE_COMPRESS_TARGET_CHARS=2000

# 综合步骤上下文治理。上游专家完整报告会优先传给综合专家；
# 仅在所有报告累计超过由模型上下文窗口推导出的预算时，才按专家分块生成临时综合简报。
# 原始报告和来源证据始终完整保存，不会因该过程被截断或覆盖。
# 可按所选主模型的上下文窗口调整；输入比例为上游报告最多占用的剩余上下文比例。
SYNTHESIS_CONTEXT_WINDOW_TOKENS=128000
SYNTHESIS_CONTEXT_INPUT_RATIO=0.75
SYNTHESIS_OUTPUT_RESERVE_TOKENS=16000
# 中文研究材料通常按约 4 字符/token 估算；不同模型可适当调整。
SYNTHESIS_CHARS_PER_TOKEN=4
SYNTHESIS_REPORT_CHUNK_CHARS=30000
SYNTHESIS_REPORT_BRIEF_TARGET_CHARS=10000
# 进程内临时简报 LRU 缓存容量。只缓存成功的模型压缩结果。
SYNTHESIS_COMPRESSION_CACHE_ENTRIES=64
# 兼容旧部署：未设置 SYNTHESIS_CONTEXT_WINDOW_TOKENS 时，使用该字符预算；
# SYNTHESIS_ROUTE_THRESHOLD_CHARS 是更早版本的兼容别名。
SYNTHESIS_REPORT_CONTEXT_BUDGET_CHARS=120000
SYNTHESIS_ROUTE_THRESHOLD_CHARS=120000
