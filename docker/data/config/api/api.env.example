# 主站登录与服务间鉴权。部署前复制为 api.env 并替换所有占位值。

# 首次启动时创建的管理员账号。后续普通账号由管理员在“运行设置”中创建和管理。
# 已完成初始化后，账号信息以 PostgreSQL 为准；请保留此管理员账号，避免既有历史任务失去归属。
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change-me-before-use

# 公网 HTTPS 部署时设为 true，使浏览器只通过 HTTPS 发送登录 Cookie。
# 本地 HTTP 开发环境保持 false 或留空。
APP_COOKIE_SECURE=false

# MCP 调用主 API 的服务间密钥。
# 必须与 mcp.env 中的 THINK_TANK_SERVICE_API_KEY 完全一致。
ORCHESTRATOR_SERVICE_API_KEY=change-me-before-use
