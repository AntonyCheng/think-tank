# syntax=docker/dockerfile:1.7

FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /app

COPY services/researcher/requirements.txt services/researcher/requirements.txt
RUN --mount=type=cache,id=thinktank-pip,target=/root/.cache/pip,sharing=locked \
    python -m pip install \
      --index-url "${PIP_INDEX_URL}" \
      -r services/researcher/requirements.txt

COPY services/researcher/app services/researcher/app
COPY services/researcher/assets services/researcher/assets
RUN mkdir -p /app/.think-tank/documents /app/.think-tank/exports

EXPOSE 8010

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8010/ready', timeout=3)"

CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "services/researcher", "--host", "0.0.0.0", "--port", "8010"]
