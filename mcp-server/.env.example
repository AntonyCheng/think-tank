# Local mode: an MCP client starts this process over stdio. No API key is used.
MCP_TRANSPORT=stdio

# Remote mode: set MCP_TRANSPORT=streamable-http and replace MCP_API_KEY with
# a high-entropy secret. Connect at https://<host>:<port>/mcp?api_key=<secret>.
MCP_HOST=127.0.0.1
MCP_PORT=7010
MCP_API_KEY=change-me-before-remote-use

# Address reachable by the Agent. Download links use this address.
MCP_PUBLIC_BASE_URL=http://10.9.0.6:7010

# Temporary exports are deleted after this many minutes.
ARTIFACT_TTL_MINUTES=15

# The MCP server only calls the public Think Tank API. It never reads SQLite.
THINK_TANK_API_URL=http://127.0.0.1:3000

# Maximum report characters returned from one selected report section.
REPORT_PAGE_CHARACTERS=6000
