# 本地模式：MCP 客户端通过 stdio 启动此进程，无需 MCP 接入密钥。
MCP_TRANSPORT=stdio

# 远程模式：将 MCP_TRANSPORT 设为 streamable-http，并将 MCP_API_KEY
# 替换为高强度密钥。连接地址为 http://<主机>:<端口>/mcp?api_key=<密钥>。
MCP_HOST=127.0.0.1
MCP_PORT=7010
MCP_API_KEY=change-me-before-remote-use

# Agent 能够访问的 MCP 服务地址，文件下载链接将使用此地址。
MCP_PUBLIC_BASE_URL=http://10.9.0.6:7010

# 临时导出文件的有效期，超过该分钟数后自动删除。
ARTIFACT_TTL_MINUTES=15

# MCP 服务仅调用需要服务鉴权的智研任务接口，不会直接读取 SQLite 数据库。
THINK_TANK_API_URL=http://127.0.0.1:3000
# 必须与主项目 .env 中的 ORCHESTRATOR_SERVICE_API_KEY 保持一致。
THINK_TANK_SERVICE_API_KEY=change-me-before-use

# 单次读取指定报告章节时允许返回的最大字符数。
REPORT_PAGE_CHARACTERS=6000
