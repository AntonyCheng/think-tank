{
  "environments": {
    "current": {
      "defaults": {
        "defaultRetriever": "duckduckgo"
      },
      "capabilities": {
        "modes": ["standard"],
        "sourceModes": ["web"],
        "retrievers": ["duckduckgo"],
        "maxRetrievers": 1,
        "sourceCuration": true,
        "domainFilters": false
      }
    },
    "expanded": {
      "defaults": {
        "defaultRetriever": "duckduckgo"
      },
      "capabilities": {
        "modes": ["standard", "deep", "synthesis"],
        "sourceModes": ["web", "urls", "local", "hybrid"],
        "retrievers": [
          "duckduckgo",
          "searx",
          "tavily",
          "arxiv",
          "openalex",
          "semantic_scholar",
          "pubmed_central"
        ],
        "maxRetrievers": 5,
        "sourceCuration": true,
        "domainFilters": true
      }
    },
    "singleRetriever": {
      "defaults": {
        "defaultRetriever": "duckduckgo"
      },
      "capabilities": {
        "modes": ["standard"],
        "sourceModes": ["web"],
        "retrievers": ["duckduckgo", "tavily"],
        "maxRetrievers": 1,
        "sourceCuration": false,
        "domainFilters": false
      }
    },
    "curationDisabled": {
      "defaults": {
        "defaultRetriever": "duckduckgo"
      },
      "capabilities": {
        "modes": ["standard"],
        "sourceModes": ["web"],
        "retrievers": ["duckduckgo"],
        "maxRetrievers": 1,
        "sourceCuration": false,
        "domainFilters": false
      }
    }
  },
  "cases": [
    {
      "name": "missing profile preserves current standard web behavior",
      "environment": "current",
      "input": null,
      "expected": {
        "schemaVersion": 1,
        "mode": "standard",
        "source": {
          "mode": "web",
          "retrievers": ["duckduckgo"]
        },
        "quality": {
          "curateSources": true
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 3,
          "maxSubtopics": 3
        }
      }
    },
    {
      "name": "partial limits override keeps all other defaults",
      "environment": "current",
      "input": {
        "schemaVersion": 1,
        "limits": {
          "maxIterations": 5
        }
      },
      "expected": {
        "schemaVersion": 1,
        "mode": "standard",
        "source": {
          "mode": "web",
          "retrievers": ["duckduckgo"]
        },
        "quality": {
          "curateSources": true
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 5,
          "maxSubtopics": 3
        }
      }
    },
    {
      "name": "profile root must be an object",
      "environment": "current",
      "input": [],
      "error": {
        "code": "profile_invalid_type",
        "path": "$"
      }
    },
    {
      "name": "explicit null source is not treated as missing",
      "environment": "current",
      "input": {
        "source": null
      },
      "error": {
        "code": "profile_invalid_type",
        "path": "$.source"
      }
    },
    {
      "name": "explicit null limits are not treated as missing",
      "environment": "current",
      "input": {
        "limits": null
      },
      "error": {
        "code": "profile_invalid_type",
        "path": "$.limits"
      }
    },
    {
      "name": "explicit null booleans are not treated as missing",
      "environment": "current",
      "input": {
        "quality": {
          "curateSources": null
        }
      },
      "error": {
        "code": "profile_invalid_type",
        "path": "$.quality.curateSources"
      }
    },
    {
      "name": "deployment credentials are rejected as unknown fields",
      "environment": "current",
      "input": {
        "apiKey": "must-not-enter-profile"
      },
      "error": {
        "code": "profile_unknown_field",
        "path": "$.apiKey"
      }
    },
    {
      "name": "schema version is not coerced from a string",
      "environment": "current",
      "input": {
        "schemaVersion": "1"
      },
      "error": {
        "code": "profile_invalid_type",
        "path": "$.schemaVersion"
      }
    },
    {
      "name": "unsupported schema version is explicit",
      "environment": "current",
      "input": {
        "schemaVersion": 2
      },
      "error": {
        "code": "profile_version_unsupported",
        "path": "$.schemaVersion"
      }
    },
    {
      "name": "research mode uses a strict enum",
      "environment": "current",
      "input": {
        "mode": "fast"
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.mode"
      }
    },
    {
      "name": "numeric limits are not coerced from strings",
      "environment": "current",
      "input": {
        "limits": {
          "maxIterations": "3"
        }
      },
      "error": {
        "code": "profile_invalid_type",
        "path": "$.limits.maxIterations"
      }
    },
    {
      "name": "numeric limits enforce platform ranges",
      "environment": "current",
      "input": {
        "limits": {
          "maxSearchResultsPerQuery": 21
        }
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.limits.maxSearchResultsPerQuery"
      }
    },
    {
      "name": "web policy normalizes domains and retains enabled quality options",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "web",
          "retrievers": ["tavily"],
          "includeDomains": ["Example.COM"],
          "excludeDomains": ["blocked.example"]
        },
        "quality": {
          "curateSources": true
        }
      },
      "expected": {
        "schemaVersion": 1,
        "mode": "standard",
        "source": {
          "mode": "web",
          "retrievers": ["tavily"],
          "includeDomains": ["example.com"],
          "excludeDomains": ["blocked.example"]
        },
        "quality": {
          "curateSources": true
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 3,
          "maxSubtopics": 3
        }
      }
    },
    {
      "name": "web policy preserves multiple academic retrievers",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "web",
          "retrievers": ["openalex", "semantic_scholar"]
        }
      },
      "expected": {
        "schemaVersion": 1,
        "mode": "standard",
        "source": {
          "mode": "web",
          "retrievers": ["openalex", "semantic_scholar"]
        },
        "quality": {
          "curateSources": true
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 3,
          "maxSubtopics": 3
        }
      }
    },
    {
      "name": "quality policy rejects unknown fields",
      "environment": "current",
      "input": {
        "quality": {
          "rankingModel": "custom"
        }
      },
      "error": {
        "code": "profile_unknown_field",
        "path": "$.quality.rankingModel"
      }
    },
    {
      "name": "retriever list cannot be empty",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "web",
          "retrievers": []
        }
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.source.retrievers"
      }
    },
    {
      "name": "retriever values use a strict enum",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "web",
          "retrievers": ["unknown"]
        }
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.source.retrievers[0]"
      }
    },
    {
      "name": "duplicate retrievers are rejected",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "web",
          "retrievers": ["duckduckgo", "duckduckgo"]
        }
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.source.retrievers"
      }
    },
    {
      "name": "domain filters accept hostnames rather than URLs",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "web",
          "includeDomains": ["https://example.com/news"]
        }
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.source.includeDomains[0]"
      }
    },
    {
      "name": "domain include and exclude lists cannot overlap",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "web",
          "includeDomains": ["EXAMPLE.com"],
          "excludeDomains": ["example.com"]
        }
      },
      "error": {
        "code": "profile_invariant_violation",
        "path": "$.source"
      }
    },
    {
      "name": "unconfigured retriever is capability gated",
      "environment": "current",
      "input": {
        "source": {
          "mode": "web",
          "retrievers": ["tavily"]
        }
      },
      "error": {
        "code": "profile_capability_disabled",
        "path": "$.source.retrievers[0]"
      }
    },
    {
      "name": "multiple retrievers are capability gated",
      "environment": "singleRetriever",
      "input": {
        "source": {
          "mode": "web",
          "retrievers": ["duckduckgo", "tavily"]
        }
      },
      "error": {
        "code": "profile_capability_disabled",
        "path": "$.source.retrievers"
      }
    },
    {
      "name": "domain filters are capability gated",
      "environment": "current",
      "input": {
        "source": {
          "mode": "web",
          "includeDomains": ["example.com"]
        }
      },
      "error": {
        "code": "profile_capability_disabled",
        "path": "$.source.includeDomains"
      }
    },
    {
      "name": "source curation is capability gated",
      "environment": "curationDisabled",
      "input": {
        "quality": {
          "curateSources": true
        }
      },
      "error": {
        "code": "profile_capability_disabled",
        "path": "$.quality.curateSources"
      }
    },
    {
      "name": "deep mode preserves explicit bounded research parameters",
      "environment": "expanded",
      "input": {
        "mode": "deep",
        "deep": {
          "breadth": 3,
          "depth": 2,
          "concurrency": 2
        }
      },
      "expected": {
        "schemaVersion": 1,
        "mode": "deep",
        "source": {
          "mode": "web",
          "retrievers": ["duckduckgo"]
        },
        "quality": {
          "curateSources": true
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 3,
          "maxSubtopics": 3
        },
        "deep": {
          "breadth": 3,
          "depth": 2,
          "concurrency": 2
        }
      }
    },
    {
      "name": "synthesis mode uses the common profile defaults",
      "environment": "expanded",
      "input": {
        "mode": "synthesis"
      },
      "expected": {
        "schemaVersion": 1,
        "mode": "synthesis",
        "source": {
          "mode": "web",
          "retrievers": ["duckduckgo"]
        },
        "quality": {
          "curateSources": false
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 3,
          "maxSubtopics": 3
        }
      }
    },
    {
      "name": "synthesis mode rejects source curation",
      "environment": "expanded",
      "input": {
        "mode": "synthesis",
        "quality": {
          "curateSources": true
        }
      },
      "error": {
        "code": "profile_invariant_violation",
        "path": "$.quality.curateSources"
      }
    },
    {
      "name": "URL source accepts absolute HTTP URLs and an optional web supplement",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "urls",
          "urls": ["https://example.com/report"],
          "web": {
            "retrievers": ["tavily"],
            "includeDomains": ["News.Example"]
          }
        }
      },
      "expected": {
        "schemaVersion": 1,
        "mode": "standard",
        "source": {
          "mode": "urls",
          "urls": ["https://example.com/report"],
          "web": {
            "retrievers": ["tavily"],
            "includeDomains": ["news.example"]
          }
        },
        "quality": {
          "curateSources": true
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 3,
          "maxSubtopics": 3
        }
      }
    },
    {
      "name": "local source accepts platform document identifiers",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "local",
          "documentIds": ["doc-2026"]
        }
      },
      "expected": {
        "schemaVersion": 1,
        "mode": "standard",
        "source": {
          "mode": "local",
          "documentIds": ["doc-2026"]
        },
        "quality": {
          "curateSources": true
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 3,
          "maxSubtopics": 3
        }
      }
    },
    {
      "name": "hybrid source combines documents with URL and web evidence",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "hybrid",
          "documentIds": ["doc-2026"],
          "urls": ["http://example.com/context"],
          "web": {
            "retrievers": ["duckduckgo"]
          }
        }
      },
      "expected": {
        "schemaVersion": 1,
        "mode": "standard",
        "source": {
          "mode": "hybrid",
          "documentIds": ["doc-2026"],
          "urls": ["http://example.com/context"],
          "web": {
            "retrievers": ["duckduckgo"]
          }
        },
        "quality": {
          "curateSources": true
        },
        "limits": {
          "maxSearchResultsPerQuery": 5,
          "maxIterations": 3,
          "maxSubtopics": 3
        }
      }
    },
    {
      "name": "deep mode requires explicit deep parameters",
      "environment": "expanded",
      "input": {
        "mode": "deep"
      },
      "error": {
        "code": "profile_invariant_violation",
        "path": "$.deep"
      }
    },
    {
      "name": "explicit null deep parameters are not treated as missing",
      "environment": "expanded",
      "input": {
        "mode": "deep",
        "deep": null
      },
      "error": {
        "code": "profile_invalid_type",
        "path": "$.deep"
      }
    },
    {
      "name": "standard mode rejects deep-only parameters",
      "environment": "expanded",
      "input": {
        "deep": {
          "breadth": 3,
          "depth": 2,
          "concurrency": 2
        }
      },
      "error": {
        "code": "profile_invariant_violation",
        "path": "$.deep"
      }
    },
    {
      "name": "deep concurrency enforces its platform range",
      "environment": "expanded",
      "input": {
        "mode": "deep",
        "deep": {
          "breadth": 3,
          "depth": 2,
          "concurrency": 17
        }
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.deep.concurrency"
      }
    },
    {
      "name": "deep mode is capability gated",
      "environment": "current",
      "input": {
        "mode": "deep",
        "deep": {
          "breadth": 3,
          "depth": 2,
          "concurrency": 2
        }
      },
      "error": {
        "code": "profile_capability_disabled",
        "path": "$.mode"
      }
    },
    {
      "name": "URL source mode is capability gated",
      "environment": "current",
      "input": {
        "source": {
          "mode": "urls",
          "urls": ["https://example.com/report"]
        }
      },
      "error": {
        "code": "profile_capability_disabled",
        "path": "$.source.mode"
      }
    },
    {
      "name": "URL source rejects non HTTP protocols",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "urls",
          "urls": ["ftp://example.com/report"]
        }
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.source.urls[0]"
      }
    },
    {
      "name": "local source rejects filesystem paths",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "local",
          "documentIds": ["../secret.pdf"]
        }
      },
      "error": {
        "code": "profile_invalid_value",
        "path": "$.source.documentIds[0]"
      }
    },
    {
      "name": "hybrid source requires URL or web evidence alongside documents",
      "environment": "expanded",
      "input": {
        "source": {
          "mode": "hybrid",
          "documentIds": ["doc-2026"]
        }
      },
      "error": {
        "code": "profile_invariant_violation",
        "path": "$.source"
      }
    }
  ]
}
