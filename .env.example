# OpenAI-compatible model endpoint used by AO planning and GPT Researcher.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Exact model names depend on the configured endpoint.
AO_PLANNER_MODEL=
AO_VERIFIER_MODEL=
# GPTR accepts provider:model. A bare model name is normalized to openai:model.
GPTR_FAST_LLM=
GPTR_SMART_LLM=
# Optional dedicated OpenAI-compatible endpoint for the embedding model.
# Leave empty to reuse OPENAI_BASE_URL.
GPTR_EMBEDDING_BASE_URL=
# OpenAI-compatible embedding model used to rank and retain scraped evidence.
# "custom" disables OpenAI-specific token-array conversion for compatible APIs.
GPTR_EMBEDDING=

# Deployment allowlist shown in the UI. Adapters that cannot be imported or
# lack required credentials are automatically omitted from /capabilities.
GPTR_ENABLED_RETRIEVERS=duckduckgo,arxiv,openalex,semantic_scholar,pubmed_central
# Ordered default selection for new tasks; must be a subset of the allowlist.
RETRIEVER=duckduckgo
# Per-task selection and per-provider timeout safety limits.
GPTR_MAX_RETRIEVERS=3
GPTR_RETRIEVER_TIMEOUT_MS=20000
# Tavily is optional. Add tavily to GPTR_ENABLED_RETRIEVERS and set its key.
TAVILY_API_KEY=

# Local service boundary.
API_HOST=127.0.0.1
API_PORT=3000
GPTR_SERVICE_URL=http://127.0.0.1:8010
AO_CONCURRENCY=2
# Maximum GPTR research worker processes. Each run receives an isolated
# environment so concurrent experts cannot leak model or retriever settings.
GPTR_WORKER_CONCURRENCY=2
# Per-task weighted budget shared by AO expert steps. Standard and synthesis
# consume 1; deep consumes its effective deep.concurrency.
GPTR_TASK_CONCURRENCY_BUDGET=4
# Deployment safety limits for GPTR recursive deep research.
GPTR_DEEP_MAX_BREADTH=4
GPTR_DEEP_MAX_DEPTH=3
GPTR_DEEP_MAX_RESEARCH_CALLS=32

# IANA time zone used to anchor "current", "today", and similar research terms.
# Keep this explicit in production so Windows, Linux, and macOS agree.
APP_TIMEZONE=Asia/Shanghai

# Time limits in milliseconds. Waiting for AO human input does not consume the
# overall task execution budget.
GPTR_HEALTH_TIMEOUT_MS=5000
GPTR_RESEARCH_TIMEOUT_MS=1800000
TASK_EXECUTION_TIMEOUT_MS=7200000
