# AO 编排与 GPT Researcher 使用的 OpenAI 兼容模型端点。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 精确的模型名称取决于配置的端点。
AO_PLANNER_MODEL=
# 编排模型的单次输出预算；OpenAI 兼容推理模型可能先生成推理内容，默认 8192
AO_PLANNER_MAX_TOKENS=8192
AO_VERIFIER_MODEL=
# GPTR 接受 provider:model 格式；裸模型名会规范化为 openai:model。
GPTR_FAST_LLM=
GPTR_SMART_LLM=
# 可选的专用 OpenAI 兼容嵌入模型端点。
# 留空时复用 OPENAI_BASE_URL。
GPTR_EMBEDDING_BASE_URL=
# 嵌入端点的可选独立密钥。留空时复用 OPENAI_API_KEY。
GPTR_EMBEDDING_API_KEY=
# 用于排序和保留抓取证据的 OpenAI 兼容嵌入模型。
# 对兼容 API，"custom" 会禁用 OpenAI 特有的 token 数组转换。
GPTR_EMBEDDING=

# 在 UI 中展示的部署允许列表。无法导入或缺少必需凭据的适配器
# 会自动从 /capabilities 中排除。
GPTR_ENABLED_RETRIEVERS=duckduckgo,arxiv,openalex,semantic_scholar,pubmed_central
# 新任务的有序默认选择；必须是允许列表的子集。
RETRIEVER=duckduckgo
# 每个任务的选择数量及每个提供商的超时安全限制。
GPTR_MAX_RETRIEVERS=3
GPTR_RETRIEVER_TIMEOUT_MS=20000
# SearXNG 为可选项。将 searx 加入 GPTR_ENABLED_RETRIEVERS 并填写实例地址。
# Docker Compose 内部地址为 http://thinktank-searxng:8080。
SEARX_URL=
# Tavily 为可选项。将 tavily 加入 GPTR_ENABLED_RETRIEVERS 并设置其密钥。
TAVILY_API_KEY=

# 本地服务边界。
API_HOST=127.0.0.1
API_PORT=3000
# 开启后，网页访问研究、历史、设置和报告前需要登录。
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change-me-before-use
# MCP 调用主 API 的服务间密钥，不能与网页账号密码混用。
ORCHESTRATOR_SERVICE_API_KEY=change-me-before-use
GPTR_SERVICE_URL=http://127.0.0.1:8010
AO_CONCURRENCY=2
# GPTR 研究工作进程的最大数量。每次运行获得独立环境，
# 以避免并发专家泄露模型或检索器设置。
GPTR_WORKER_CONCURRENCY=2
# AO 专家步骤共享的每任务加权预算。standard 和 synthesis 消耗 1；
# deep 消耗其有效的 deep.concurrency。
GPTR_TASK_CONCURRENCY_BUDGET=4
# GPTR 递归深度研究的部署安全限制。
GPTR_DEEP_MAX_BREADTH=4
GPTR_DEEP_MAX_DEPTH=3
GPTR_DEEP_MAX_RESEARCH_CALLS=32

# 综合步骤上下文压缩：去重后总字符超过路由阈值才启动萃取；
# 单篇正文超过萃取阈值才送 LLM 压缩，目标长度为萃取上限。
SYNTHESIS_ROUTE_THRESHOLD_CHARS=250000
SYNTHESIS_EXTRACT_THRESHOLD_CHARS=2500
SYNTHESIS_EXTRACT_TARGET_CHARS=2000

# 用于锚定“当前”“今天”等研究时间表述的 IANA 时区。
# 在生产环境中保持显式配置，以确保 Windows、Linux 和 macOS 一致。
APP_TIMEZONE=Asia/Shanghai

# 时间限制单位为毫秒。等待 AO 人工输入不消耗
# 总体任务执行预算。
GPTR_HEALTH_TIMEOUT_MS=5000
GPTR_RESEARCH_TIMEOUT_MS=1800000
# 在 AO 重试同一步骤前，为 Researcher 停止工作进程并返回终态结果
# 预留的时间。该值应小于研究超时。
GPTR_CLEANUP_GRACE_MS=20000
# 默认使用静态来源提取。仅当静态提取为空时，浏览器回退才用于
# 依赖 JavaScript 的指定 URL。
GPTR_SOURCE_FALLBACK_PROVIDERS=
GPTR_SOURCE_FALLBACK_TIMEOUT_MS=45000
PLAYWRIGHT_BROWSERS_PATH=.think-tank/playwright-browsers

# 任务级本地文档的隔离存储与解析限制。
LOCAL_DOCUMENTS_ROOT=.think-tank/documents
LOCAL_DOCUMENT_MAX_BYTES=26214400
LOCAL_DOCUMENT_TASK_MAX_BYTES=104857600
LOCAL_DOCUMENT_MAX_COUNT=20
# 预留给后续独立解析进程；当前解析受任务总执行时限约束。
LOCAL_DOCUMENT_PARSE_TIMEOUT_MS=30000

# 示例注册表中的远程服务使用此变量。实际部署请按注册表引用名称配置。

TASK_EXECUTION_TIMEOUT_MS=7200000
